DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# DATABASE_URL=postgres://user:pass@localhost:5432/social_media_manager
# OPENAI_API_KEY=sk-...  # optional; can also be saved from the app: Settings -> API keys
# Google Analytics 4 (optional). Paste the service-account key file as JSON and
# the numeric property id; both can also be saved from Settings -> API keys.
# GOOGLE_ANALYTICS_CREDENTIALS={"type": "service_account", "project_id": "...", ...}
# GOOGLE_ANALYTICS_PROPERTY_ID=123456789
# Instagram comment research (optional). Unofficial: it uses the sessionid cookie
# of a logged-in (throwaway) account to read commenters on public posts. Can also
# be saved from Settings -> API keys. Likers are not available. Set the enabled
# flag to False to hide the section entirely.
# INSTAGRAM_SESSIONID=12345678%3AAbCdEf...
# INSTAGRAM_USERNAME=my_burner
# INSTAGRAM_PROXY=http://user:pass@host:port
# INSTAGRAM_SCRAPER_ENABLED=True
# INSTAGRAM_MAX_COMMENTS=500
# INSTAGRAM_TIMEOUT=20
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Registration is open until the first account exists (that account becomes the
# admin), then closed. Set True to keep allowing /api/register/ afterwards.
DJANGO_ALLOW_REGISTRATION=False
# CORS: dev defaults allow everything; for deploy set allow-all to False and list origins.
DJANGO_CORS_ALLOW_ALL=True
# DJANGO_CORS_ORIGINS=https://campaigns.example.com
